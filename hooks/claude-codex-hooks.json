{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/elf-activate.js\"",
            "timeout": 5,
            "statusMessage": "Loading elf workflow..."
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/elf-subagent.js\"",
            "timeout": 5,
            "statusMessage": "Injecting role contract..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/elf-tracker.js\"",
            "timeout": 5,
            "statusMessage": "Tracking delegation..."
          }
        ]
      }
    ]
  }
}
